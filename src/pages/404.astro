---
import "@fontsource-variable/inter";
import "@fontsource-variable/sora";
import { asset } from "../lib/asset";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="This page doesn't exist on kalinduwijekoon.com."
    />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#060913" />
    <meta name="color-scheme" content="dark" />
    <title>Page not found | Kalindu Wijekoon</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href={asset("styles.css")} />
  </head>
  <body>
    <div class="site-bg" aria-hidden="true">
      <i class="bg-orb bo-1"></i>
      <i class="bg-orb bo-2"></i>
      <i class="bg-orb bo-3"></i>
    </div>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <header class="site-header">
      <nav class="nav shell" aria-label="Primary">
        <a class="brand" href="/" aria-label="Kalindu Wijekoon, home">
          <span class="brand-mark" aria-hidden="true">
            K
          </span>
          <span class="brand-name" aria-hidden="true">
            Kalindu <span class="brand-dim">Wijekoon</span>
          </span>
        </a>
      </nav>
    </header>

    <main id="main-content">
      <section class="notfound shell">
        <p class="notfound-code">404 · Not found</p>
        <h1>Outside the perimeter.</h1>
        <p class="notfound-summary">
          There's nothing at this address. It may have moved, or it never
          existed.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/">
            Back to home <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href="mailto:reach.kalindu@gmail.com">
            Get in touch
          </a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <span>© 2026 Kalindu Wijekoon</span>
        <span>Based in Sri Lanka, open to relocation</span>
      </div>
    </footer>
  </body>
</html>
