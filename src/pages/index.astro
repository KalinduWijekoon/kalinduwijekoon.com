      class="defs-only"
      width="0"
      height="0"
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <linearGradient id="g-stroke" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#4de1ff"></stop>
          <stop offset="1" stop-color="#b18cff"></stop>
        </linearGradient>
        <linearGradient
          id="g-cloud"
          gradientUnits="userSpaceOnUse"
          x1="0"
          y1="0"
          x2="0"
          y2="215"
        >
          <stop offset="0" stop-color="#9aa8ff"></stop>
          <stop offset="1" stop-color="#3b3fd0"></stop>
        </linearGradient>
        <linearGradient
          id="g-cloud-cyan"
          gradientUnits="userSpaceOnUse"
          x1="0"
          y1="0"
          x2="0"
          y2="215"
        >
          <stop offset="0" stop-color="#8fe9ff"></stop>
          <stop offset="1" stop-color="#2a6fd0"></stop>
        </linearGradient>
        <linearGradient
          id="g-cloud-violet"
          gradientUnits="userSpaceOnUse"
          x1="0"
          y1="0"
          x2="0"
          y2="215"
        >
          <stop offset="0" stop-color="#d2b4ff"></stop>
          <stop offset="1" stop-color="#5b3fc4"></stop>
        </linearGradient>
        <linearGradient
          id="g-cloud-teal"
          gradientUnits="userSpaceOnUse"
          x1="0"
          y1="0"
          x2="0"
          y2="215"
        >
          <stop offset="0" stop-color="#9ff5e0"></stop>
          <stop offset="1" stop-color="#1f7f8f"></stop>
        </linearGradient>
        <linearGradient
          id="g-beam"
          gradientUnits="userSpaceOnUse"
          x1="0"
          y1="108"
          x2="0"
          y2="170"
        >
          <stop offset="0" stop-color="#bff6ff" stop-opacity="0.95"></stop>
          <stop offset="1" stop-color="#4de1ff" stop-opacity="0.45"></stop>
        </linearGradient>
        <linearGradient
          id="g-beam2"
          gradientUnits="userSpaceOnUse"
          x1="0"
          y1="118"
          x2="0"
          y2="250"
