<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Cybersecurity engineer portfolio with a strong bias toward cloud platforms, detection engineering, and practical security automation."
    />
    <meta name="theme-color" content="#060913" />
    <meta name="color-scheme" content="dark" />
    <meta
      property="og:title"
      content="Kalindu Wijekoon | Cybersecurity Engineer"
    />
    <meta
      property="og:description"
      content="A practical cybersecurity portfolio, with a cloud-first focus. Based in Sri Lanka, open to relocation."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${siteUrl}/`} />
    <meta property="og:image" content={`${siteUrl}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Defend the systems. Kalindu Wijekoon, cybersecurity engineer."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <title>Kalindu Wijekoon | Cybersecurity Engineer</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/styles.css" />
