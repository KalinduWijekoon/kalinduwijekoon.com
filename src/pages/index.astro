        <radialGradient id="g-light">
          <stop offset="0" stop-color="#ffffff" stop-opacity="0.42"></stop>
          <stop offset="1" stop-color="#ffffff" stop-opacity="0"></stop>
        </radialGradient>
        <radialGradient id="g-shine">
          <stop offset="0" stop-color="#bff6ff" stop-opacity="0.32"></stop>
          <stop offset="1" stop-color="#bff6ff" stop-opacity="0"></stop>
        </radialGradient>
        <clipPath id="clip-cloud">
          <g transform="translate(140 180) scale(0.973)">
            <rect x="10" y="120" width="340" height="90" rx="45"></rect>
            <circle cx="80" cy="125" r="62"></circle>
            <circle cx="170" cy="80" r="84"></circle>
            <circle cx="262" cy="110" r="66"></circle>
            <circle cx="318" cy="150" r="48"></circle>
          </g>
        </clipPath>
        <clipPath id="clip-shield">
          <path d="M313 226 L371 248 V294 C371 332 347 356 313 370 C279 356 255 332 255 294 V248 Z"></path>
