          <stop offset="0" stop-color="#bff6ff" stop-opacity="0.95"></stop>
          <stop offset="1" stop-color="#4de1ff" stop-opacity="0.45"></stop>
        </linearGradient>
        <linearGradient
          id="g-cloud-shine"
          gradientUnits="userSpaceOnUse"
          x1="0"
          y1="0"
          x2="0"
          y2="150"
        >
          <stop offset="0" stop-color="#ffffff" stop-opacity="0.55"></stop>
          <stop offset="0.55" stop-color="#ffffff" stop-opacity="0"></stop>
        </linearGradient>
        <radialGradient id="g-glow">
          <stop offset="0" stop-color="#4de1ff" stop-opacity="0.28"></stop>
          <stop offset="1" stop-color="#4de1ff" stop-opacity="0"></stop>
