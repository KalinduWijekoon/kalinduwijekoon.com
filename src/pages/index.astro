---
import "@fontsource-variable/inter";
const siteUrl = "https://kalinduwijekoon.com";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Cybersecurity engineer portfolio with a strong bias toward cloud platforms, detection engineering, and practical security automation."
    />
    <meta name="theme-color" content="#08111f" />
    <meta property="og:title" content="Cybersecurity Engineer | Portfolio" />
    <meta
      property="og:description"
      content="A practical cybersecurity portfolio, with a cloud-first focus. Based in Sri Lanka, open to relocation."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${siteUrl}/`} />
    <meta property="og:image" content={`${siteUrl}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Defend the systems. Kalindu Wijekoon, cybersecurity engineer."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <title>Cybersecurity Engineer | Portfolio</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <header class="site-header">
      <nav class="nav shell" aria-label="Primary navigation">
        <a class="brand" href="#top" aria-label="Home">
          <span class="brand-mark" aria-hidden="true">
            K
          </span>
          <span>
            Kalindu<span class="brand-accent"> Wijekoon</span>
          </span>
        </a>
        <button
          class="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="nav-links"
        >
          Menu
        </button>
        <div class="nav-links" id="nav-links">
          <a href="#focus">Focus</a>
          <a href="#work">Selected work</a>
          <a href="#approach">Approach</a>
          <a class="nav-cta" href="mailto:reach.kalindu@gmail.com">
            Let's connect <span aria-hidden="true">↗</span>
          </a>
        </div>
      </nav>
    </header>

    <main id="main-content">
      <section class="hero shell" id="top">
        <div class="hero-banner" aria-hidden="true">
          <div class="banner-parallax">
            <svg
              class="banner-graphic"
              viewBox="0 0 1180 700"
              preserveAspectRatio="xMidYMid meet"
              xmlns="http://www.w3.org/2000/svg"
            >
              <g class="banner-orbit">
                <circle class="banner-dot" cx="730" cy="350" r="11"></circle>
                <circle class="banner-dot" cx="230" cy="560" r="9"></circle>
                <circle class="banner-dot" cx="260" cy="160" r="9"></circle>
              </g>
              <g class="banner-cloud">
                <rect x="300" y="330" width="260" height="90" rx="45"></rect>
                <circle cx="360" cy="310" r="48"></circle>
                <circle cx="430" cy="275" r="60"></circle>
                <circle cx="500" cy="305" r="50"></circle>
                <circle cx="545" cy="335" r="38"></circle>
                <circle cx="270" cy="335" r="34"></circle>
              </g>
            </svg>
          </div>
        </div>
        <div class="hero-copy">
          <h1>Defend the systems.</h1>
          <p class="hero-summary">
            Cybersecurity engineering with a strong bias toward cloud platforms
            — useful guardrails, measurable detection, and infrastructure that
            developers can trust.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#work">
              Explore selected work <span aria-hidden="true">↓</span>
            </a>
            <a class="text-link" href="mailto:reach.kalindu@gmail.com">
              Get in touch <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <div class="hero-aside" aria-label="Current focus">
          <div class="terminal-card-frame">
            <div class="terminal-card">
              <div class="terminal-top">
                <span></span>
                <span></span>
                <span></span>
                <span class="terminal-label">security_context.yml</span>
              </div>
              <div class="terminal-body">
                <p>
                  <span class="code-muted">profile:</span>{" "}
                  <span class="code-value">cybersecurity_engineer</span>
                </p>
                <p>
                  <span class="code-muted">focus:</span>{" "}
                  <span class="code-value">cloud_security</span>
                </p>
                <p>
                  <span class="code-muted">location:</span>{" "}
                  <span class="code-value">Sri_Lanka</span>
                </p>
                <p>
                  <span class="code-muted">relocation:</span>{" "}
                  <span class="code-value">open_to_relocation</span>
                </p>
                <p>
                  <span class="code-muted">default:</span>{" "}
                  <span class="code-value">secure_by_design</span>
                </p>
                <p>
                  <span class="code-muted">signal:</span>{" "}
                  <span class="code-green">● systems_online</span>
                </p>
              </div>
            </div>
          </div>
          <div class="metric-row">
            <div>
              <strong>03</strong>
              <span>security domains</span>
            </div>
            <div>
              <strong>∞</strong>
              <span>learning mindset</span>
            </div>
          </div>
        </div>
      </section>

      <section class="section shell" id="focus">
        <div class="section-heading">
          <p class="eyebrow">01 / What I focus on</p>
          <h2>
            Security that makes
            <br />
            <em>momentum possible.</em>
          </h2>
        </div>
        <div class="focus-grid">
          <article class="focus-card focus-card-featured">
            <span class="card-number">01</span>
            <div>
              <h3>Cloud foundations</h3>
              <p>
                Designing landing zones, identity boundaries, logging, and
                policy guardrails that scale with the organization.
              </p>
              <ul class="tag-list">
                <li>AWS / Azure</li>
                <li>IAM</li>
                <li>Policy as code</li>
              </ul>
            </div>
          </article>
          <article class="focus-card">
            <span class="card-number">02</span>
            <div>
              <h3>Detection & response</h3>
              <p>
                Turning cloud telemetry into useful signals, triage playbooks,
                and response workflows that reduce uncertainty.
              </p>
              <ul class="tag-list">
                <li>SIEM</li>
                <li>Threat detection</li>
                <li>Incident response</li>
              </ul>
            </div>
          </article>
          <article class="focus-card">
            <span class="card-number">03</span>
            <div>
              <h3>Secure delivery</h3>
              <p>
                Embedding security checks into CI/CD so teams find issues early
                without slowing down delivery.
              </p>
              <ul class="tag-list">
                <li>GitHub Actions</li>
                <li>IaC scanning</li>
                <li>Supply chain</li>
              </ul>
            </div>
          </article>
        </div>
      </section>

      <section class="section section-dark" id="work">
        <div class="shell">
          <div class="section-heading section-heading-light">
            <p class="eyebrow">02 / Selected work</p>
            <h2>
              Proof over <em>promises.</em>
            </h2>
            <p class="section-intro">
              Sample case studies for the portfolio. Replace these with your own
              labs, assessments, and measurable outcomes.
            </p>
          </div>
          <div class="work-list">
            <article class="work-item">
              <div class="work-index">01</div>
              <div class="work-content">
                <p class="work-kicker">Cloud governance · AWS</p>
                <h3>Guardrails without friction</h3>
                <p>
                  A reference landing zone that combines least-privilege access,
                  centralized audit trails, and preventive controls with a clear
                  developer path.
                </p>
                <a
                  class="work-link"
                  href="mailto:reach.kalindu@gmail.com?subject=Cloud%20governance%20case%20study"
                >
                  Discuss the approach <span aria-hidden="true">↗</span>
                </a>
              </div>
              <div class="work-visual visual-grid" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
              </div>
            </article>
            <article class="work-item">
              <div class="work-index">02</div>
              <div class="work-content">
                <p class="work-kicker">Detection engineering · CloudTrail</p>
                <h3>From noisy logs to signals</h3>
                <p>
                  A detection pack for suspicious identity activity, with tested
                  hypotheses, severity context, and response notes for an
                  on-call team.
                </p>
                <a
                  class="work-link"
                  href="mailto:reach.kalindu@gmail.com?subject=Detection%20engineering%20case%20study"
                >
                  Discuss the approach <span aria-hidden="true">↗</span>
                </a>
              </div>
              <div class="work-visual visual-pulse" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
              </div>
            </article>
            <article class="work-item">
              <div class="work-index">03</div>
              <div class="work-content">
                <p class="work-kicker">DevSecOps · GitHub Actions</p>
                <h3>Security in the pull request</h3>
                <p>
                  A lightweight pipeline for secrets, dependencies,
                  infrastructure, and container checks with actionable developer
                  feedback.
                </p>
                <a
                  class="work-link"
                  href="mailto:reach.kalindu@gmail.com?subject=DevSecOps%20case%20study"
                >
                  Discuss the approach <span aria-hidden="true">↗</span>
                </a>
              </div>
              <div class="work-visual visual-bars" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
                <span></span>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="section shell approach-section" id="approach">
        <div class="section-heading">
          <p class="eyebrow">03 / My approach</p>
          <h2>
            Clear thinking.
            <br />
            <em>Practical outcomes.</em>
          </h2>
        </div>
        <div class="approach-grid">
          <div class="approach-copy">
            <p class="lead">
              Good security engineering is not a gate at the end of delivery. It
              is a set of well-designed decisions that help a team move with
              confidence.
            </p>
            <p>
              I work from threat models and real operational constraints, then
              turn them into controls people can understand, automate, and
              improve. The goal is a safer system and a stronger engineering
              culture.
            </p>
            <a class="button button-dark" href="mailto:reach.kalindu@gmail.com">
              Start a conversation <span aria-hidden="true">↗</span>
            </a>
          </div>
          <ol class="principles">
            <li>
              <span>01</span>
              <div>
                <strong>Understand the system</strong>
                <p>
                  Map assets, identities, data flows, and the risks that matter
                  to the business.
                </p>
              </div>
            </li>
            <li>
              <span>02</span>
              <div>
                <strong>Reduce the blast radius</strong>
                <p>
                  Prefer small, composable controls over brittle security
                  theatre.
                </p>
              </div>
            </li>
            <li>
              <span>03</span>
              <div>
                <strong>Make the secure path easy</strong>
                <p>
                  Build feedback loops and defaults that work with the team, not
                  against it.
                </p>
              </div>
            </li>
          </ol>
        </div>
      </section>

      <section class="cta-section">
        <div class="shell cta-inner">
          <p class="eyebrow">Have a meaningful security problem?</p>
          <h2>
            Let's make your systems
            <br />
            <em>safer to move fast in.</em>
          </h2>
          <a
            class="button button-primary"
            href="mailto:reach.kalindu@gmail.com"
          >
            reach.kalindu@gmail.com <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <span>
          © <span id="year">2026</span> Kalindu Wijekoon
        </span>
        <span>Built with care · Based in Sri Lanka, open to relocation</span>
        <a href="#top">Back to top ↑</a>
      </div>
    </footer>
    <script src="/script.js" defer></script>
  </body>
</html>
